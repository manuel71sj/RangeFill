{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RangeFill",
  "version": "0.1.0",
  "identifier": "com.manuel71.rangefill",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "RangeFill", "width": 420, "height": 800 }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "icon": ["icons/app-icon.svg.png"],
    "active": true,
    "targets": "all"
  }
}
