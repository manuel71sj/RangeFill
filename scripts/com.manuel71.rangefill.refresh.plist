<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- __REPO__·__HOME__·__UDID__는 README의 등록 명령이 채운다. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.manuel71.rangefill.refresh</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__REPO__/scripts/ios-refresh.sh</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>RANGEFILL_DEVICE</key>
        <string>__UDID__</string>
    </dict>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>10</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/RangeFill/refresh.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/RangeFill/refresh.log</string>
</dict>
</plist>
